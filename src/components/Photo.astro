---
// Foto com proporção fixa. Sem src, não renderiza nada.
interface Props {
  src?: string;
  alt?: string;
  width?: number;
  height?: number;
  class?: string;
  overlay?: boolean;
  eager?: boolean;
}
const { src, alt = '', width = 800, height = 600, class: cls, overlay = false, eager = false } = Astro.props;
---
{src && (
  <div class:list={['photo', overlay && 'photo--overlay', cls]} style={`aspect-ratio:${width}/${height}`}>
    <img src={src} alt={alt} width={width} height={height} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
  </div>
)}
