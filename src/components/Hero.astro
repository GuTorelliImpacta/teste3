---
import Cta from './Cta.astro';
import Photo from './Photo.astro';
import NextClass from './NextClass.astro';
import { content } from '../content/site';
import type { ClassKind } from '../data/schedule';

interface Props {
  title: string;
  lead: string;
  photo?: { src: string; alt: string };
  kinds?: ClassKind[];
  variant?: 'home' | 'page';
  secondary?: { href: string; label: string };
}
const { title, lead, photo, kinds, variant = 'page', secondary } = Astro.props;
const hasPhoto = Boolean(photo?.src);
const bg = variant === 'home' && hasPhoto;
const side = variant === 'page' && hasPhoto;
---
<section class:list={['hero', bg && 'hero--bg']} aria-labelledby="h1">
  {bg && <Photo class="hero-bg" src={photo!.src} alt="" width={1600} height={900} overlay eager />}
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 id="h1" class="rise">{title}</h1>
      <p class="lead rise">{lead}</p>
      {content.aulaExperimental && <p class="trial rise">Primeira aula experimental: <strong>{content.aulaExperimental}</strong></p>}
      <div class="btn-row rise">
        <Cta />
        {secondary && <a class="btn btn-ghost" href={secondary.href}>{secondary.label}</a>}
      </div>
    </div>
    {side
      ? <Photo class="hero-side" src={photo!.src} alt={photo!.alt} width={1600} height={900} overlay eager />
      : <NextClass kinds={kinds} />}
  </div>
</section>
