---
import Base from '../layouts/Base.astro';
import Schedule from '../components/Schedule.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { weeklyHyrox } from '../data/schedule';

const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'HYROX', item: `${site.url}/hyrox` },
  ],
};
const stations = ['SkiErg', 'Sled push', 'Sled pull', 'Burpee broad jump', 'Remo', 'Farmers carry', 'Afundo com saco de areia', 'Wall balls'];
---
<Base
  title="Treino de HYROX na zona norte de SP | CT ZN"
  description="Treino de HYROX no Tucuruvi, zona norte de São Paulo: aulas durante a semana e aos sábados no Centro de Treinamento ZN. Veja os horários."
  path="/hyrox"
  schema={[crumbs]}
>
  <section class="hero" aria-labelledby="h1">
    <div class="wrap" style="padding-block:56px 72px">
      <div class="hero-copy" style="max-width:52rem">
        <h1 id="h1" class="rise">Treino de HYROX na zona norte.</h1>
        <p class="lead rise">Corrida e estações de força na mesma aula. {weeklyHyrox} horários por semana no Tucuruvi.</p>
        <div class="btn-row rise">
          <a class="btn btn-red" href={`tel:${site.phone.tel}`}>Agendar aula</a>
          <a class="btn btn-ghost" href="#grade">Ver horários de HYROX</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band on-paper" aria-labelledby="oque">
    <div class="wrap split">
      <h2 id="oque">O que é HYROX</h2>
      <div class="prose">
        <p class="lead">É uma prova de fitness em que você corre 1 km e executa um exercício, oito vezes seguidas, sempre na mesma ordem.</p>
        <p>As estações são:</p>
        <ul class="facts">
          {stations.map((s) => <li><strong>{s}</strong></li>)}
        </ul>
        <p>No ZN, as aulas de HYROX trabalham corrida, força e transição entre os dois, com coach. Treine para a prova ou use a aula para ganhar condicionamento.</p>
      </div>
    </div>
  </section>

  <section class="band on-deep" id="grade" aria-labelledby="grade-t">
    <div class="wrap">
      <h2 id="grade-t">Horários de HYROX</h2>
      <Schedule kinds={['hyrox']} />
      <p class="note">Horários sujeitos a alteração. Confirme pelo telefone {site.phone.display}.</p>
    </div>
  </section>
  <CtaBand title="Venha treinar HYROX" />
</Base>
