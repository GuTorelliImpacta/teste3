---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Hours from '../components/Hours.astro';
import { site, whatsappUrl, routeUrl, mapsUrl } from '../data/site';
import { faq } from '../data/faq';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Contato', item: `${site.url}/contato` },
  ],
};
---
<Base
  title="Contato e como chegar | CT ZN, Tucuruvi"
  description="Telefone, endereço e horário do Centro de Treinamento ZN: Av. Nova Cantareira, 4066, Tucuruvi, São Paulo. Agende sua aula experimental."
  path="/contato"
  schema={[faqSchema, crumbs]}
>
  <section class="band first on-deep" id="agendar" aria-labelledby="h1">
    <div class="wrap split">
      <div class="prose">
        <h1 id="h1">Agende sua aula</h1>
        <p class="lead">Ligue{whatsappUrl ? ' ou chame no WhatsApp' : ''}, diga o dia e o horário que prefere e a recepção confirma para você.</p>
        <div class="btn-row">
          <a class="btn btn-red" href={`tel:${site.phone.tel}`}>Ligar {site.phone.display}</a>
          {whatsappUrl && <a class="btn btn-ghost" href={whatsappUrl} rel="noopener noreferrer">Chamar no WhatsApp</a>}
          <a class="btn btn-white" href={site.instagram.url} rel="noopener noreferrer">Instagram {site.instagram.handle}</a>
        </div>
      </div>
      <div>
        <h2 style="font-size:2rem;margin-bottom:14px">Horário de funcionamento</h2>
        <Hours />
        <p class="note">Em feriados o horário pode mudar.</p>
      </div>
    </div>
  </section>

  <section class="band on-paper" aria-labelledby="onde">
    <div class="wrap split">
      <div class="prose">
        <h2 id="onde">Como chegar</h2>
        <p class="where-addr">{site.address.street}<br />{site.address.district}, São Paulo – SP</p>
        <p class="lead">CEP {site.address.zip}</p>
        <div class="btn-row">
          <a class="btn btn-red" href={routeUrl} rel="noopener noreferrer">Traçar rota</a>
          <a class="btn btn-ghost" href={mapsUrl} rel="noopener noreferrer">Abrir no Google Maps</a>
        </div>
      </div>
      <div>
        <h2 style="margin-bottom:8px">Dúvidas frequentes</h2>
        <Faq />
      </div>
    </div>
  </section>
</Base>
